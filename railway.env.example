# Railway Environment Variables for MailZero
# Copy this file to your Railway project environment variables

# Application Configuration
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database (Railway PostgreSQL Plugin)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis (Railway Redis Plugin) 
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_TOKEN=your_redis_token

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here_32_chars_min
COOKIE_DOMAIN=your-custom-domain.com
BETTER_AUTH_SECRET=your_better_auth_secret_32_chars
VOICE_SECRET=your_voice_secret_key

# Google OAuth & Gmail API
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_S_ACCOUNT={}

# AI Services
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MINI_MODEL=gpt-3.5-turbo
USE_OPENAI=true

# Alternative AI Services
GROQ_API_KEY=your_groq_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Email Services
RESEND_API_KEY=your_resend_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
DISABLE_CALLS=false

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co/v1/traces
OTEL_SERVICE_NAME=mailzero-railway

# Datadog (optional)
DD_API_KEY=your_datadog_api_key
DD_APP_KEY=your_datadog_app_key
DD_SITE=datadoghq.com

# Application URLs (Update with your custom domain)
VITE_PUBLIC_APP_URL=https://your-custom-domain.com
VITE_PUBLIC_BACKEND_URL=https://your-custom-domain.com/api
NEXT_PUBLIC_BACKEND_URL=https://your-custom-domain.com/api
NEXT_PUBLIC_APP_URL=https://your-custom-domain.com

# Feature Flags
DROP_AGENT_TABLES=false
THREAD_SYNC_MAX_COUNT=60
THREAD_SYNC_LOOP=true
DISABLE_WORKFLOWS=false
DISABLE_CALLS=false

# File Upload & Storage
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/tmp/uploads

# Cloudflare (if keeping some services)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Meet Integration (optional)
MEET_AUTH_HEADER=your_meet_auth_header

# Auto RAG ID (optional)
AUTORAG_ID=your_autorag_id
